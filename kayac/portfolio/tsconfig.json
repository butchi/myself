{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "rootDir": "src/js",
    "outDir": "js"
  },
  "include": ["src/js/**/*.ts"],
  "exclude": ["node_modules"]
}
